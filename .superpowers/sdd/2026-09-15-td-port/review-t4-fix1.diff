+        "load_tracks": staticmethod(lambda *a, **k: tracks),
+        "tracks_to_dat_text": staticmethod(lambda t: "dat"),
+        "save_tracks": staticmethod(lambda path, t: written.append((path, t))),
+        "Debouncer": ui_logic.Debouncer,
